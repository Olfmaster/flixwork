# E-Mail-Versand der Anfragen (Konfigurator + Fragebogen) über Resend.
# Ohne RESEND_API_KEY werden Anfragen nur in der Server-Konsole geloggt
# (die Seite funktioniert trotzdem, es wird nur nichts verschickt).
RESEND_API_KEY=

# Zieladresse für Monteur-Konfigurator-Anfragen (Herr Wolf).
KONFIGURATOR_EMAIL=wolf@flixwork.de

# Zieladresse für Logistik-/Industrie-Anfragen.
ANFRAGE_EMAIL=info@flixwork.de

# Absender (muss in Resend als verifizierte Domain hinterlegt sein).
# Default nutzt die Resend-Sandbox-Adresse.
CONTACT_FROM=Flixwork Website <onboarding@resend.dev>

# Live Google Business-Bewertungen (Startseite + alle Bereichs-Unterseiten).
# Ohne beide Werte bleibt der Platzhaltertext "folgt in Kürze" sichtbar.
# Places API (legacy) im Google Cloud Projekt aktivieren, Key erzeugen;
# Place ID über den Place ID Finder von Google ermitteln.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# Stellenanzeigen aus zvoove (Jobbörse).
# Solange diese beiden Werte fehlen, zeigt die Jobbörse die Platzhalter aus
# lib/jobs-demo.js und blendet oben einen Vorschau-Hinweis ein. Sobald beide
# gesetzt sind, zieht die Seite automatisch die echten Stellen.
# Basis-URL der zvoove-Instanz, ohne Schrägstrich am Ende,
# z. B. https://<mandant>.europersonal.com
ZVOOVE_API_BASE=
# API-Key aus dem zvoove-Adminbereich.
ZVOOVE_API_KEY=

# Zieladresse für Bewerbungen (Formular /bewerben und Stellendetailseiten).
BEWERBUNG_EMAIL=info@flixwork.de
